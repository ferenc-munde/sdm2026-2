{
  "name": "@team-2/game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Last Train: a 5-carriage co-operative survival train (Team 2)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite client --host 127.0.0.1",
    "dev:server": "tsx server.ts",
    "build": "tsc --noEmit && vite build client",
    "preview": "vite preview client --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.10",
    "colyseus": "^0.18.12",
    "three": "^0.170.0",
    "zod": "^4.6.7",
    "@colyseus/schema": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "tsx": "^4.23.15",
    "vite": "^7.3.8",
    "vitest": "^3.0.0"
  }
}
