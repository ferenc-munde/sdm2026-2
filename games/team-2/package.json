{
  "name": "@team-2/game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Last Train: a 5-carriage co-operative survival train (Team 2)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite client --host 127.0.0.1",
    "dev:server": "vite-node server.ts",
    "build": "tsc --noEmit && vite build client",
    "preview": "vite preview client --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "server": "vite-node server.ts"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.8",
    "@colyseus/sdk": "^0.18.1",
    "@sdm/core": "workspace:*",
    "@sdm/host": "workspace:*",
    "colyseus": "^0.18.1",
    "three": "^0.170.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.8",
    "vite-node": "^3.2.0",
    "vitest": "^3.0.0"
  }
}
